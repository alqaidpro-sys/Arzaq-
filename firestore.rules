rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helper
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper for validating job advertisements
    function isValidJob(job) {
      return job.title is string && job.title.size() <= 200
          && job.type in ['worker', 'job']
          && job.catId is string
          && job.desc is string && job.desc.size() <= 3000;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidJob(request.resource.data);
      allow update: if isSignedIn() && isValidJob(request.resource.data);
      allow delete: if isSignedIn();
    }
    
    // Dynamic connection-check collection rules
    match /test_sdk_connection/{testId} {
      allow read, write: if true;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helper
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Helper for validating job advertisements
    function isValidJob(job) {
      return job.title is string && job.title.size() <= 200
          && job.type in ['worker', 'job', 'need-worker', 'need-job']
          && job.catId is string
          && job.desc is string && job.desc.size() <= 3000;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if true; // Allow adding jobs easily even for anonymous or registered users
      allow update: if true;
      allow delete: if true;
    }

    match /users/{userId} {
      allow read, write: if true; // Allow user profiles to be retrieved and updated seamlessly
    }
    
    // Dynamic connection-check collection rules
    match /test_sdk_connection/{testId} {
      allow read, write: if true;
    }
  }
}
